# Set these in Render Environment. Do NOT upload real credentials to GitHub.
APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SECRET_KEY=GENERATE_A_RANDOM_64_CHARACTER_VALUE
PUBLIC_URL=https://YOUR-VIQ.onrender.com
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=CHOOSE_A_UNIQUE_LONG_PASSWORD
# Optional TURN server. STUN alone does not work on every mobile network.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
